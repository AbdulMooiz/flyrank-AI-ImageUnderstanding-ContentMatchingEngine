APP_NAME=ai-image-matching-engine
APP_ENV=development
APP_DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/app
DATABASE_ECHO=false

GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

VISION_CONFIDENCE_THRESHOLD=0.72
MATCH_SIMILARITY_THRESHOLD=0.35

AI_RETRY_COUNT=3
AI_RETRY_DELAY_SECONDS=2

CORPUS_DIR=./data/corpus
SEED_DATA_PATH=./data/seed

POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
